# Copy to .env and fill in real values. Never commit .env.
# Use TEST-MODE keys for Paystack/Flutterwave in local/staging — never production keys outside prod.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://user:password@localhost:5432/econnect

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PAYSTACK_SECRET_KEY=
# Paystack signs webhooks with this SAME secret key (unlike some providers,
# there's no separate webhook-signing secret) — see utils/paystack-webhook.ts.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FIREBASE_SERVER_KEY=
SMS_PROVIDER_API_KEY=

QR_SIGNING_SECRET=

# Venue booking deposit commission, in basis points (1000 = 10%). See
# utils/venue-commission.ts — v1 charges the full deposit to Econnect's
# account and records this split for manual payout, it does not auto-split
# via a Paystack subaccount (owners aren't onboarded for that yet).
VENUE_COMMISSION_BPS=1000
